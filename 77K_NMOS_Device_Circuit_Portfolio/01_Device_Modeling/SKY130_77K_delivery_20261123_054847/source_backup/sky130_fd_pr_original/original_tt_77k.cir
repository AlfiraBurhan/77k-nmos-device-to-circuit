Original SKY130 TT extrapolated to 77 K
.include "/content/sky130_fd_pr_original/original_nmos_only.spice"
.option scale=1u
.param mc_mm_switch=0 mc_pr_switch=0
.temp -196.15
VD d 0 0.01
VG g 0 0
X1 d g 0 0 sky130_fd_pr__nfet_01v8_lvt l=0.15 w=1.6
.control
set wr_singlescale
set wr_vecnames
dc VG 0 1.85 0.01
let idrain = -i(VD)
wrdata original_tt_77k_idvg.txt v(g) idrain
quit
.endc
.end
